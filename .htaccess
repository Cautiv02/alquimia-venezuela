Options -Indexes
DirectoryIndex index.php

# Archivos internos: nadie debe poder leerlos desde la web
<FilesMatch "^(config-ve\.php|ve-schema\.ok|.*-cache\.json)$">
  Require all denied
</FilesMatch>

# Portada limpia: /ve/venezuela-catalogo.php  ->  /ve/
<IfModule mod_rewrite.c>
RewriteEngine On
RewriteCond %{REQUEST_METHOD} =GET
RewriteCond %{THE_REQUEST} \s(/[^\s?]*/)(?:index|venezuela-catalogo3?)\.php(\?[^\s]*)?\s [NC]
RewriteRule ^ %1%2 [R=301,L,NE]
</IfModule>

# Sitemap: /ve/sitemap.xml -> sitemap.php (regla aislada)
<IfModule mod_rewrite.c>
RewriteRule ^sitemap\.xml$ sitemap.php [L]
</IfModule>
