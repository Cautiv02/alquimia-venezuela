# .htaccess — URLs limpias para la tienda de Venezuela (Apache / LiteSpeed)
# Si algo falla, borra este archivo: el sitio sigue funcionando con las direcciones normales (.php).
Options -Indexes
DirectoryIndex index.php

# Archivos internos: nunca se sirven directo
<FilesMatch "^(config-ve\.php|ve-schema\.ok|.*-cache\.json)$">
  Require all denied
</FilesMatch>

<IfModule mod_rewrite.c>
RewriteEngine On

# 1) La portada vive en la carpeta: /ve/venezuela-catalogo.php, /ve/venezuela-catalogo3.php e index.php -> /ve/
RewriteCond %{REQUEST_METHOD} =GET
RewriteCond %{THE_REQUEST} \s(/[^\s?]*/)(?:index|venezuela-catalogo3?)(?:\.php)?(\?[^\s]*)?\s [NC]
RewriteRule ^ %1%2 [R=301,L,NE]

# 2) Quitar ".php" de la dirección visible (solo GET; el cron queda como está)
RewriteCond %{REQUEST_METHOD} =GET
RewriteCond %{REQUEST_URI} !ve-cron
RewriteCond %{THE_REQUEST} \s(/[^\s?]*?)\.php(\?[^\s]*)?\s [NC]
RewriteRule ^ %1%2 [R=301,L,NE]

# 3) Servir /ve/venezuela-producto como venezuela-producto.php
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME}.php -f
RewriteRule ^(.+?)/?$ $1.php [L]
</IfModule>
